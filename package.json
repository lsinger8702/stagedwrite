{
  "name": "stagedwrite",
  "version": "0.0.1",
  "private": true,
  "description": "An experimental staged-write library for agent tools.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run demo:publish-resume",
    "demo:publish-resume": "npm run build && node scripts/run-walkthrough.mjs",
    "demo:html": "npm run demo:publish-resume -- --write-report && node scripts/render-walkthrough.mjs",
    "verify:package": "npm run build && node scripts/package-smoke.mjs",
    "verify:walkthrough": "npm run demo:publish-resume -- --check-report && node scripts/render-walkthrough.mjs --check && node --test scripts/walkthrough.test.mjs",
    "test:stripe": "npm run build && node --test examples/stripe/*.test.mjs",
    "demo:stripe": "npm run build && node examples/stripe/run.mjs",
    "test:stripe-update": "npm run build && node --test examples/stripe-update/*.test.mjs",
    "demo:update": "npm run build && node examples/stripe-update/run.mjs --offline --write-report",
    "verify:update": "npm run build && node --test examples/stripe-update/*.test.mjs && node examples/stripe-update/run.mjs --offline --check",
    "demo:agent": "npm run build && node dist/examples/agent-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
