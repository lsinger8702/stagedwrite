{
  "name": "stagedwrite",
  "version": "0.0.1",
  "private": true,
  "description": "An experimental staged-write library for agent tools.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run demo:publish-resume",
    "demo:publish-resume": "npm run build && node dist/examples/publish-resume.js",
    "demo:html": "npm run demo:publish-resume -- --write-report && node scripts/render-walkthrough.mjs",
    "verify:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
