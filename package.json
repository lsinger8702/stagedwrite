{
  "name": "stagedwrite-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "An experimental staged-write library for agent tools.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/examples/lifecycle.js",
    "demo:registry": "npm run build && node dist/examples/registry.js",
    "demo:graph": "npm run build && node dist/examples/graph.js",
    "demo:preflight": "npm run build && node dist/examples/preflight.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
